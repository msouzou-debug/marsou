{
  "name": "ecapital",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @ecapital/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check:i18n": "node scripts/check-i18n-parity.mjs apps/web/src/i18n && node scripts/check-api-i18n-parity.mjs",
    "check:help": "node scripts/check-help-mapping.mjs",
    "api:dev": "pnpm --filter @ecapital/api dev",
    "api:migrate": "pnpm --filter @ecapital/api migrate",
    "api:seed": "pnpm --filter @ecapital/api seed",
    "api:openapi": "pnpm --filter @ecapital/api openapi"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "unrs-resolver",
      "@parcel/watcher"
    ]
  }
}
