{
  "name": "ecapital",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "pnpm --filter @ecapital/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check:i18n": "node scripts/check-i18n-parity.mjs apps/web/src/i18n && node scripts/check-api-i18n-parity.mjs",
    "check:help": "node scripts/check-help-mapping.mjs",
    "guides:build": "node scripts/manual-index.mjs && node scripts/build-guides.mjs",
    "test:guides-script": "node --test scripts/build-guides.test.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "api:dev": "pnpm --filter @ecapital/api dev",
    "api:migrate": "pnpm --filter @ecapital/api migrate",
    "api:seed": "pnpm --filter @ecapital/api seed",
    "api:openapi": "pnpm --filter @ecapital/api openapi",
    "pc:setup": "node scripts/pc.mjs setup",
    "pc:start": "node scripts/pc.mjs start",
    "pc:stop": "node scripts/pc.mjs stop"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "unrs-resolver",
      "@parcel/watcher",
      "@embedded-postgres/linux-x64",
      "@embedded-postgres/windows-x64",
      "@embedded-postgres/darwin-arm64",
      "@embedded-postgres/darwin-x64"
    ]
  },
  "dependencies": {
    "marked": "^18.0.13"
  },
  "devDependencies": {
    "embedded-postgres": "16.14.0-beta.17",
    "pg": "^8.23.0"
  }
}
