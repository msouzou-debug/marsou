{
  "name": "okypy-kpi-app",
  "version": "2.0.0-m1",
  "private": true,
  "description": "ΟΚΥπΥ — Πίνακας Δεικτών Νοσοκομείου. Builds to one self-contained, fully offline HTML file.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "fixtures": "node test/fixtures/make-fixtures.mjs",
    "pretest": "npm run build && npm run fixtures",
    "test": "node --test test/unit.test.mjs test/build.test.mjs test/golden.test.mjs test/export.test.mjs",
    "test:unit": "node --test test/unit.test.mjs",
    "test:build": "node --test test/build.test.mjs",
    "test:golden": "node --test test/golden.test.mjs",
    "test:export": "node --test test/export.test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "playwright": "1.56.0"
  }
}
