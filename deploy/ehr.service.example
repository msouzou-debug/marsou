# Example only. Marios installs and runs every sudo step himself.
[Unit]
Description=eHR (gunicorn)
After=network.target

[Service]
User=ehr
Group=ehr
WorkingDirectory=/opt/ehr
EnvironmentFile=/etc/ehr/ehr.env
ExecStart=/opt/ehr/.venv/bin/gunicorn -c deploy/gunicorn.conf.py wsgi:app
Restart=on-failure

[Install]
WantedBy=multi-user.target
