# eCapital API (NestJS) — systemd unit for the ΟΚΥπΥ server (10.227.56.22).
#
# Install once with `deploy/install.sh`; `deploy/release.sh` only restarts it.
# Binds 127.0.0.1:5015 only — the API is never reached by a browser, only by
# the web app running server-side on the same host (see docs/deploy/RUNBOOK-10.227.56.22.md).
# NO_PROXY below matters because systemd units do not read /etc/environment's
# http_proxy: without it, any loopback call the API makes — eFinance on 5004,
# eArchive's ingest route on 5011 — goes through the host's Squid proxy and
# gets a fake 503. It is unconditional and covers both (ADR-0022, ADR-0023).

[Unit]
Description=eCapital API (NestJS)
Documentation=https://github.com/ (see docs/deploy/RUNBOOK-10.227.56.22.md in the repo)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=ecapital
Group=ecapital
WorkingDirectory=/opt/ecapital/apps/api
EnvironmentFile=/etc/ecapital/api.env
Environment=NO_PROXY=127.0.0.1,localhost
# pnpm resolves the workspace filter from the repo root; WorkingDirectory only
# has to be inside it. The released tree keeps pnpm-workspace.yaml at /opt/ecapital.
ExecStart=/usr/bin/pnpm --filter @ecapital/api start
Restart=always
RestartSec=5
TimeoutStopSec=30

# --- hardening -------------------------------------------------------------
# The process needs to write logs and read its own tree, and nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
# /var/lib/ecapital/documents is the eArchive object store (ADR-0023,
# DOCUMENT_STORE_DIR): the operational copy of a file the API has to have in
# hand to upload it. Nothing else outside the release tree is writable.
ReadWritePaths=/var/log/ecapital /opt/ecapital/apps/api /var/lib/ecapital/documents
UMask=0027

# --- logging -----------------------------------------------------------
# JSON lines to the journal (apps/api/README.md "Notes"); read with
# `journalctl -u ecapital-api`. No separate log file needed.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ecapital-api

[Install]
WantedBy=multi-user.target
