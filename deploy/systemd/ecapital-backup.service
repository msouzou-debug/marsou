# Nightly pg_dump of the ecapital database (CAPEX-01 §3: "nightly pg_dump...
# monthly test restore, logged"). Triggered by ecapital-backup.timer.
# One-shot: runs, dumps, prunes, exits. Failures show up as a failed unit in
# `systemctl status ecapital-backup.service` and in the journal.

[Unit]
Description=eCapital nightly database backup (pg_dump)
After=postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=ecapital
Group=ecapital
ExecStart=/opt/ecapital/deploy/backup.sh
# Backups only touch /var/backups/ecapital; nothing else is writable.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/backups/ecapital /var/log/ecapital
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ecapital-backup
