# eHR environment file. Copy to /etc/ehr/ehr.env, owner root, group ehr, mode 640.
# One NAME=value per line. No export, no spaces around "=". Quote a value that holds spaces or # characters.
# Every variable the app reads is listed here. Values below are placeholders, not real settings.
# systemd reads this file (EnvironmentFile) and scripts/ehr-cli.sh reads the same file for cron and admin commands.

# --- Core -------------------------------------------------------------------------------------------------------
# "production" turns on the start-up checks: real secret, CSRF on, SQLite file placed safely, no debug, AD over checked LDAPS. Anything else is development.
EHR_ENV=production
# Signs the session cookie and the CSRF token. At least 32 random characters. Make one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
EHR_SECRET_KEY=
# SQLAlchemy URL of the database. SQLite is the production engine (decision of 14/11/2026). The file must have an absolute path
# outside the code folder, for example sqlite:////var/lib/ehr/ehr.sqlite3 (four slashes), in a folder the ehr user can write:
# WAL mode creates ehr.sqlite3-wal and ehr.sqlite3-shm beside it. Back it up with `flask backup-db`, never by copying the file.
EHR_DATABASE_URI=
# SQLite only: milliseconds a writer waits for the database lock before giving up (default 5000).
EHR_SQLITE_BUSY_TIMEOUT_MS=5000
# Public address of the app. The button in every email points here, for example https://ehr.example.invalid
EHR_BASE_URL=
# true when users reach the app over HTTPS: sets the Secure cookie flag and the HSTS header.
EHR_HTTPS=true
# Number of reverse proxies in front of gunicorn that set X-Forwarded-For and -Proto. 0 trusts none.
EHR_PROXY_HOPS=0
# Address gunicorn listens on. Port 5008 is a proposal: Marios assigns the real one.
EHR_BIND=127.0.0.1:5008
# gunicorn worker count (default 1). SQLite has one writer: the server refuses to start with more than 1 on SQLite.
EHR_WORKERS=1

# Time zone for every time shown to people and for the working-day count (a zoneinfo name). Times are stored in UTC.
# The server needs the system time zone database (the tzdata package); without it the app refuses to start.
EHR_TIMEZONE=Europe/Nicosia

# --- Sessions ---------------------------------------------------------------------------------------------------
# Minutes without a request before the user is signed out (default 30).
EHR_SESSION_IDLE_MINUTES=30
# Hours after sign-in when the session ends whatever the user does (default 12).
EHR_SESSION_MAX_HOURS=12

# --- Documents --------------------------------------------------------------------------------------------------
# Folder for uploaded files. Must exist and be writable by the ehr user. Back it up together with the database.
EHR_STORAGE_DIR=/var/lib/ehr/storage
# Full path of soffice (LibreOffice) for Word and Excel previews. Empty means look on PATH. No LibreOffice means no preview.
EHR_SOFFICE_BIN=
# Seconds one Office to PDF conversion may take (default 60).
EHR_CONVERT_TIMEOUT=60
# Most megabytes an Office file may expand to when unzipped (default 200). Larger files are refused.
EHR_MAX_UNZIPPED_MB=200

# --- Active Directory sign-in (optional; local accounts keep working when it is off or the server is down) -------------
# true to let people sign in with their Windows account. The first sign-in makes an inactive account that an administrator activates.
EHR_AD_ENABLED=false
# Domain controller host name, as in its certificate (for example dc1.example.invalid).
EHR_AD_SERVER=
# LDAPS port (default 636). No StartTLS, no plain LDAP.
EHR_AD_PORT=636
# Domain the user name is bound with: the bind is <username>@<domain>, for example example.invalid
EHR_AD_DOMAIN=
# Where to look the user up after sign-in to read the full name and email, for example DC=example,DC=invalid. Empty: no lookup.
EHR_AD_BASE_DN=
# Attribute that holds the user name in the directory (default sAMAccountName).
EHR_AD_UID_ATTRIBUTE=sAMAccountName
# Path of the organisation's internal CA certificate (PEM file from IT) used to check the server certificate. Required in production.
EHR_AD_CA_FILE=
# Seconds to wait to connect and to receive an answer (default 5).
EHR_AD_TIMEOUT=5
# Keep true. False (plain LDAP) is for a throwaway test server and is refused in production.
EHR_AD_USE_SSL=true

# --- Email (the mail_backend setting in the app chooses outbox_only, smtp or graph) ------------------------------
# Sender address for the smtp backend.
EHR_MAIL_FROM=
# smtp backend: mail server host name.
EHR_SMTP_HOST=
# smtp backend: port (default 587).
EHR_SMTP_PORT=587
# smtp backend: user name. Empty means no login.
EHR_SMTP_USER=
# smtp backend: password.
EHR_SMTP_PASSWORD=
# smtp backend: 1 to use STARTTLS (default 1).
EHR_SMTP_STARTTLS=1
# graph backend: Microsoft Entra tenant id.
EHR_GRAPH_TENANT=
# graph backend: application (client) id of the app registration with the Mail.Send application permission.
EHR_GRAPH_CLIENT_ID=
# graph backend: client secret of that registration.
EHR_GRAPH_CLIENT_SECRET=
# graph backend: mailbox address that sends the mail.
EHR_GRAPH_SENDER=

# --- ΟΑΥ activity figures from eFinance (optional; empty URL or token means "not configured") ----------------------
# Base address of the read-only eFinance endpoint. Agreed through Marios.
EHR_EFINANCE_URL=
# Bearer token for that endpoint. Never put it anywhere else.
EHR_EFINANCE_TOKEN=
# Seconds to wait for eFinance before the form falls back to typed figures (default 5).
EHR_EFINANCE_TIMEOUT=5
# Optional path of a private CA bundle for the eFinance HTTPS certificate.
EHR_EFINANCE_CA_FILE=
