# eCapital API — production environment file for the ΟΚΥπΥ server
# (10.227.56.22). Copy to /etc/ecapital/api.env (mode 600, owner ecapital)
# and fill in every CHANGE-ME. Never commit the filled-in file.
#
# This mirrors apps/api/.env.example plus the on-prem additions
# (AUTH_MODE=ldap, LDAP_*, SESSION_SECRET, EMAP_URL, EFINANCE_URL, BIND_HOST)
# that replace the Entra-ID-only picture in ADR-0009 for this deployment: the
# server signs in against the on-prem `ihcis.local` Active Directory that
# eFinance and eMAP already use, not a cloud Entra tenant. See
# docs/deploy/RUNBOOK-10.227.56.22.md for where each value comes from.

# production always here. config.ts refuses to boot with DEV_AUTH=1 under this.
NODE_ENV=production
# The API listens on this port, on BIND_HOST only.
PORT=5015
# 127.0.0.1: the API is reached by the web app's own server process on the
# same host, never directly by a browser (see deploy/cloudflared-request.md).
# Nothing else on this host may use 5015. Port 5014 is reserved by the host
# owner — never use it. 5000-5006, 5010-5012 and 5055 are already taken by
# other services.
BIND_HOST=127.0.0.1
# fatal | error | warn | info | debug | trace | silent. JSON lines either way.
LOG_LEVEL=info
# The web app sits behind cloudflared, which terminates TLS off-box; this
# tells the API's HTTP layer to trust the forwarded-proto/for headers it
# receives from that first hop (there is no nginx or other proxy in front of
# the API itself — the web app calls it directly over loopback).
TRUST_PROXY=1

# --- database ----------------------------------------------------------
# PostgreSQL 16.14 is already installed on this host at 127.0.0.1:5432,
# shared with BedMan and eArchive — we never install or reconfigure it.
# Marios creates the `ecapital` role and database (docs/deploy/RUNBOOK-
# 10.227.56.22.md §2.1 has the paste-ready SQL); we only fill in the
# password he sets, here.
#
# The application role. Not the owner of the tables — row-level security
# applies to it (ADR-0010).
DATABASE_URL=postgres://ecapital_app:CHANGE-ME@127.0.0.1:5432/ecapital
# The owner role, used by `pnpm migrate` and `pnpm seed` only.
MIGRATION_DATABASE_URL=postgres://ecapital:CHANGE-ME@127.0.0.1:5432/ecapital
# Maximum connections in the pool. Keep it near the worker count (1 process here).
DATABASE_POOL_MAX=10

# --- authentication (ADR-0009, on-prem addition) ------------------------
# ldap: bind against the on-prem Active Directory, the same one eFinance and
# eMAP use for sign-in. Production on this server is always `ldap`, never
# `dev`. config.ts refuses to boot with DEV_AUTH=1 in production regardless.
AUTH_MODE=ldap
# 0 in production, always. 1 only in local development against the throwaway
# test database (ADR-0012).
DEV_AUTH=0
# Unused while AUTH_MODE=ldap; keep set so config.ts has a value either way.
DEV_AUTH_SECRET=CHANGE-ME

# The domain controller(s). As of 19/09/2026, `ihcis.local` does not resolve
# from 10.227.56.22 and neither 389 nor 636 answer. This is BLOCKING for
# go-live: IT must supply the domain controllers' IPs or FQDNs, open 636
# (LDAPS) from 10.227.56.22, and give a read-only bind account before this
# can be filled in for real (docs/deploy-checklist.md has this as a
# blocking item owned by IT).
#
# Prefer LDAPS once IT gives a DC address:
LDAP_URL=ldaps://CHANGE-ME.ihcis.local:636
LDAP_DOMAIN=ihcis.local
# The search base, e.g. DC=ihcis,DC=local plus an OU if sign-in is restricted
# to one. Match eFinance's `ad_base_dn` setting unless told otherwise.
LDAP_BASE_DN=CHANGE-ME
# STARTTLS is the documented fallback ONLY, if 636 turns out not to be
# available and IT asks us to use plain 389 with STARTTLS instead. Leave 0
# while LDAP_URL is ldaps://; set to 1 only if you switch LDAP_URL back to
# ldap://...:389.
LDAP_START_TLS=0

# Signs the session token the API issues after a successful LDAP bind (the
# production replacement for the DEV_AUTH stub of ADR-0009 — there is no
# external identity provider issuing a verifiable token to check instead, so
# the API signs and verifies its own). Generate with `openssl rand -hex 32`
# and never reuse the value from another environment.
SESSION_SECRET=CHANGE-ME

# --- Entra ID (ADR-0009) -------------------------------------------------
# Left blank: this deployment authenticates against on-prem AD (AUTH_MODE=ldap
# above), not a cloud Entra ID tenant. Fill these in only if the organisation
# later moves this deployment to Entra ID; config.ts should not require them
# while AUTH_MODE=ldap.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_AUDIENCE=
OIDC_JWKS_URI=

# el or en. The language of error messages when Accept-Language says nothing.
DEFAULT_LOCALE=el
# The web app's origin. Browsers never call this API directly (BIND_HOST is
# loopback-only), but CORS stays configured as a safety net for local tooling
# run on the server itself.
CORS_ORIGINS=https://capital.shso.online

# --- links to the sibling systems on this server ------------------------
# Base URL eCapital links out to for an eMAP contract reference
# (`{EMAP_URL}/contracts?q=<ref>`), the same pattern as eFinance's `emap_url`
# setting (INTEGRATION-eMAP.md §3). Read-only link, no credentials, no DB access.
EMAP_URL=https://map.shso.online
# Base URL eCapital links out to for eFinance (invoices, budget position).
# For a human's link-out this is the public hostname; the API's own calls to
# eFinance's read/write routes (§4 below) go over loopback instead, straight
# to http://127.0.0.1:5004 — see docs/INTEGRATION-eFinance-eMAP-eCapital.md §4.
EFINANCE_URL=https://finance.shso.online
# The single bearer token eFinance issues eCapital as its one caller, for the
# loopback contract in docs/INTEGRATION-eFinance-eMAP-eCapital.md §4/§5
# (draft, agreed in principle 19/09/2026; ADR-0022). Get the real value from
# the eFinance team — never invent one, never reuse another environment's.
EFINANCE_TOKEN=CHANGE-ME
# Where the loopback contract answers. The contract fixes it to this host's
# port 5004 (ADR-0022); change it only on a UAT box that runs eFinance
# elsewhere. Never a public hostname: the routes refuse forwarded traffic.
EFINANCE_API_URL=http://127.0.0.1:5004
