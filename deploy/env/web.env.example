# eCapital web app — production environment file for the ΟΚΥπΥ server
# (10.227.56.22). Copy to /etc/ecapital/web.env (mode 600, owner ecapital)
# and fill in every CHANGE-ME. Never commit the filled-in file.
#
# Mirrors apps/web/.env.example plus the production/on-prem additions.
# Both NEXT_PUBLIC_ variables below are inlined into the browser bundle at
# build time — never put a secret in a NEXT_PUBLIC_ value.

NODE_ENV=production
# Belt-and-braces alongside the systemd unit's `-p 5013 -H 127.0.0.1`: keep
# this in sync with deploy/systemd/ecapital-web.service if either changes.
PORT=5013
# Loopback only. Public exposure goes through the host's existing nginx
# (proxy_pass to 127.0.0.1:5013) and cloudflared beyond that — see
# docs/deploy/RUNBOOK-10.227.56.22.md and deploy/cloudflared-request.md.
# We never edit nginx or cloudflared ourselves; the runbook hands Marios a
# paste-ready server block.
BIND_HOST=127.0.0.1
# nginx is the one hop in front of this app and terminates TLS at Cloudflare
# beyond that; this tells Next's server to trust the X-Forwarded-* headers
# that hop sets, so redirects and the origin the app reports match
# https://capital.shso.online instead of http://…:5013.
TRUST_PROXY=1

# The API, reached over loopback — this is a server-side call the browser
# never makes (ADR-0013: the bearer token lives in an httpOnly cookie the
# browser cannot read).
NEXT_PUBLIC_API_BASE=http://127.0.0.1:5015

# The public origin cloudflared publishes. Used to build absolute links and
# to validate the app's own redirects.
NEXT_PUBLIC_APP_ORIGIN=https://capital.shso.online

# ldap: sign-in collects an ihcis.local username and password and the API
# verifies them against Active Directory (see api.env.example AUTH_MODE).
NEXT_PUBLIC_AUTH_MODE=ldap
# 0 in production, always. With 1 the sign-in screen would show the six
# seeded development accounts (ADR-0009) — never on the ΟΚΥπΥ server.
NEXT_PUBLIC_DEV_AUTH=0
