# eHire environment file. Copy to /etc/ehire/ehire.env, owner root, group ehire, mode 640.
# One NAME=value per line. No export, no spaces around "=". Quote a value that holds spaces or # characters.
# Every variable the app reads is listed here. Values below are placeholders, not real settings.
# systemd reads this file (EnvironmentFile) and scripts/ehire-cli.sh reads the same file for cron and admin commands.

# --- Core -------------------------------------------------------------------------------------------------------
# "production" turns on the start-up checks: real secret, CSRF on, SQLite file placed safely, no debug, AD over checked LDAPS. Anything else is development.
EHIRE_ENV=production
# Signs the session cookie and the CSRF token. At least 32 random characters. Make one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
EHIRE_SECRET_KEY=
# SQLAlchemy URL of the database. SQLite is the production engine (decision of 14/11/2026). The file must have an absolute path
# outside the code folder, for example sqlite:////var/lib/ehire/ehire.sqlite3 (four slashes), in a folder the ehire user can write:
# WAL mode creates ehire.sqlite3-wal and ehire.sqlite3-shm beside it. Back it up with `flask backup-db`, never by copying the file.
EHIRE_DATABASE_URI=
# SQLite only: milliseconds a writer waits for the database lock before giving up (default 5000).
EHIRE_SQLITE_BUSY_TIMEOUT_MS=5000
# Public address of the app. The button in every email points here. On the ΟΚΥπΥ server eHire is published through
# the Cloudflare tunnel as https://ehire.shso.online
EHIRE_BASE_URL=https://ehire.shso.online
# true when users reach the app over HTTPS: sets the Secure cookie flag and the HSTS header.
EHIRE_HTTPS=true
# Number of reverse proxies in front of gunicorn that set X-Forwarded-For and -Proto. 0 trusts none.
# 1 on the ΟΚΥπΥ server: the Cloudflare tunnel is the one proxy.
EHIRE_PROXY_HOPS=1
# Address gunicorn listens on. Port 5008 is eHire's port on the ΟΚΥπΥ server. The Cloudflare tunnel runs on another
# machine and connects to this server's network address, so eHire must listen on every interface (0.0.0.0), not only
# on 127.0.0.1. Limit port 5008 in the firewall to the tunnel's machine: the port is plain HTTP.
EHIRE_BIND=0.0.0.0:5008
# gunicorn worker count (default 1). SQLite has one writer: the server refuses to start with more than 1 on SQLite.
EHIRE_WORKERS=1

# Time zone for every time shown to people and for the working-day count (a zoneinfo name). Times are stored in UTC.
# The server needs the system time zone database (the tzdata package); without it the app refuses to start.
EHIRE_TIMEZONE=Europe/Nicosia

# --- Sessions ---------------------------------------------------------------------------------------------------
# Minutes without a request before the user is signed out (default 30).
EHIRE_SESSION_IDLE_MINUTES=30
# Hours after sign-in when the session ends whatever the user does (default 12).
EHIRE_SESSION_MAX_HOURS=12

# --- Documents --------------------------------------------------------------------------------------------------
# Folder for uploaded files. Must exist and be writable by the ehire user. Back it up together with the database.
EHIRE_STORAGE_DIR=/var/lib/ehire/storage
# Full path of soffice (LibreOffice) for Word and Excel previews. Empty means look on PATH. No LibreOffice means no preview.
EHIRE_SOFFICE_BIN=
# Seconds one Office to PDF conversion may take (default 60).
EHIRE_CONVERT_TIMEOUT=60
# Most megabytes an Office file may expand to when unzipped (default 200). Larger files are refused.
EHIRE_MAX_UNZIPPED_MB=200

# --- eArchive deposits (the archive_transport setting chooses none, folder or http; default none sends nothing) ---
# Folder the "folder" transport writes each deposit into (one sub-folder per request and kind). Must exist and be
# writable by the ehire user. Empty is fine while the transport is none.
EHIRE_ARCHIVE_DROP_DIR=
# Address of eArchive's API for the "http" transport. Must be plain http on this machine (127.0.0.1, ::1 or localhost);
# anything else stops eHire from starting. Default http://127.0.0.1:5011.
EHIRE_ARCHIVE_URL=http://127.0.0.1:5011
# eArchive's token for eHire (its setting EHR_INGEST_TOKEN in /opt/emetroon/.env). Copy it from file to file without
# printing it (deploy/README.md). Empty means nothing is sent. Also checks the notices eArchive sends back.
EHIRE_ARCHIVE_TOKEN=
# eArchive's public web address, once IT publishes it (http or https, for example https://earchive.example.invalid; a
# trailing slash is fine). Empty shows the protocol number as plain text. Set, the number links to
# <address>/protocols/<protocol id>, for every request including old ones. A bad value stops eHire from starting.
EHIRE_ARCHIVE_WEB_URL=

# --- Active Directory sign-in (optional; local accounts keep working when it is off or the server is down) -------------
# true to let people sign in with their Windows account. The first sign-in makes an inactive account that an administrator activates.
EHIRE_AD_ENABLED=false
# Domain controller host name, as in its certificate (for example dc1.example.invalid).
EHIRE_AD_SERVER=
# LDAPS port (default 636). No StartTLS, no plain LDAP.
EHIRE_AD_PORT=636
# Domain the user name is bound with: the bind is <username>@<domain>, for example example.invalid
EHIRE_AD_DOMAIN=
# Where to look the user up after sign-in to read the full name and email, for example DC=example,DC=invalid. Empty: no lookup.
EHIRE_AD_BASE_DN=
# Attribute that holds the user name in the directory (default sAMAccountName).
EHIRE_AD_UID_ATTRIBUTE=sAMAccountName
# Path of the organisation's internal CA certificate (PEM file from IT) used to check the server certificate. Required in production.
EHIRE_AD_CA_FILE=
# Seconds to wait to connect and to receive an answer (default 5).
EHIRE_AD_TIMEOUT=5
# Keep true. False (plain LDAP) is for a throwaway test server and is refused in production.
EHIRE_AD_USE_SSL=true

# --- Email (the mail_backend setting in the app chooses outbox_only, smtp or graph) ------------------------------
# Sender address for the smtp backend.
EHIRE_MAIL_FROM=
# smtp backend: mail server host name.
EHIRE_SMTP_HOST=
# smtp backend: port (default 587).
EHIRE_SMTP_PORT=587
# smtp backend: user name. Empty means no login.
EHIRE_SMTP_USER=
# smtp backend: password.
EHIRE_SMTP_PASSWORD=
# smtp backend: 1 to use STARTTLS (default 1).
EHIRE_SMTP_STARTTLS=1
# graph backend: Microsoft Entra tenant id.
EHIRE_GRAPH_TENANT=
# graph backend: application (client) id of the app registration with the Mail.Send application permission.
EHIRE_GRAPH_CLIENT_ID=
# graph backend: client secret of that registration.
EHIRE_GRAPH_CLIENT_SECRET=
# graph backend: mailbox address that sends the mail.
EHIRE_GRAPH_SENDER=

# --- eFinance link (docs/contracts/07-efinance-link.md; also the ΟΑΥ figures of contract 05) -------------------------
# Off until the `efinance_link` setting is `http` (flask efinance-link http, after flask efinance-test passes).
# Base address of eFinance on this server: http://127.0.0.1:5004 (eFinance's own port, never the public address).
# Plain http is accepted only for 127.0.0.1, ::1 or localhost; any other host needs https with a checked certificate.
EHIRE_EFINANCE_URL=
# Bearer token for eFinance's two read-only endpoints. Marios copies it file to file. Never put it anywhere else.
EHIRE_EFINANCE_TOKEN=
# Seconds to wait for eFinance before a card says the figures are unavailable and works as before (default 5).
EHIRE_EFINANCE_TIMEOUT=5
# Optional path of a private CA bundle for an https eFinance address (not needed for http://127.0.0.1:5004).
EHIRE_EFINANCE_CA_FILE=
