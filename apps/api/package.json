{
  "name": "@ecapital/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "node -r @swc-node/register --watch src/main.ts",
    "start": "node -r @swc-node/register src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node -r @swc-node/register src/db/migrate.ts",
    "seed": "node -r @swc-node/register src/db/seed.ts",
    "import:capex": "node -r @swc-node/register src/cli/import-capex.ts",
    "grant-admin": "node -r @swc-node/register src/cli/grant-admin.ts",
    "grant-role": "node -r @swc-node/register src/cli/grant-role-cli.ts",
    "openapi": "node -r @swc-node/register scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@ecapital/shared": "workspace:*",
    "@nestjs/common": "^11",
    "@nestjs/core": "^11",
    "@nestjs/platform-express": "^11",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11",
    "drizzle-orm": "^0.45",
    "exceljs": "^4.4.0",
    "jose": "^6",
    "ldapts": "^9.2.0",
    "nestjs-pino": "^5",
    "pg": "^8",
    "pino": "^10",
    "pino-http": "^11",
    "reflect-metadata": "^0.2",
    "rxjs": "^7",
    "yaml": "^2.9.1",
    "zod": "^4"
  },
  "devDependencies": {
    "@nestjs/testing": "^11",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1",
    "@types/express": "^5",
    "@types/multer": "^2.2.0",
    "@types/node": "^22",
    "@types/pg": "^8",
    "@types/supertest": "^6",
    "drizzle-kit": "^0.31",
    "eslint": "^9",
    "supertest": "^7",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "unplugin-swc": "^1",
    "vitest": "^3"
  }
}
