{
  "name": "@ecapital/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "openapi": "tsx scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@ecapital/shared": "workspace:*",
    "@nestjs/common": "^11",
    "@nestjs/core": "^11",
    "@nestjs/platform-express": "^11",
    "@nestjs/swagger": "^11",
    "drizzle-orm": "^0.45",
    "jose": "^6",
    "nestjs-pino": "^5",
    "pg": "^8",
    "pino": "^10",
    "pino-http": "^11",
    "reflect-metadata": "^0.2",
    "rxjs": "^7",
    "zod": "^4"
  },
  "devDependencies": {
    "@nestjs/testing": "^11",
    "@swc/core": "^1",
    "@types/express": "^5",
    "@types/node": "^22",
    "@types/pg": "^8",
    "@types/supertest": "^6",
    "drizzle-kit": "^0.31",
    "eslint": "^9",
    "supertest": "^7",
    "tsx": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "unplugin-swc": "^1",
    "vitest": "^3"
  }
}
