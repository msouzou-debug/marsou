# eCapital API — every variable the process reads. config.ts validates all of
# them at boot and refuses to start on a bad one. Copy to .env and edit.

# development | test | production. Production refuses DEV_AUTH.
NODE_ENV=development
# Port the API listens on. The web app expects 3001 by default.
PORT=3001
# fatal | error | warn | info | debug | trace | silent. JSON lines either way.
LOG_LEVEL=info

# The application role. It is not the owner of the tables, so row-level security applies to it.
DATABASE_URL=postgres://ecapital_app:change-me@localhost:5432/ecapital
# The owner role, used by `pnpm migrate` and `pnpm seed` only. Defaults to DATABASE_URL.
MIGRATION_DATABASE_URL=postgres://ecapital:change-me@localhost:5432/ecapital
# Maximum connections in the pool. One per concurrent request, so keep it near your worker count.
DATABASE_POOL_MAX=10

# 1 turns on the local token stub for development and tests (ADR-0009). Never 1 in production.
DEV_AUTH=1
# The key the stub signs with. At least 16 characters. Irrelevant when DEV_AUTH is off.
DEV_AUTH_SECRET=ecapital-dev-auth-secret-not-for-production

# Entra ID tenant issuer, for example https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_ISSUER=
# The application (client) id registered in Entra ID.
OIDC_CLIENT_ID=
# The audience the access token must carry, usually the API's application id URI.
OIDC_AUDIENCE=
# Signing keys. Left empty, it is derived from OIDC_ISSUER.
OIDC_JWKS_URI=

# el or en. The language of error messages when Accept-Language says nothing.
DEFAULT_LOCALE=el
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
