# eCapital API — every variable the process reads. config.ts validates all of
# them at boot and refuses to start on a bad one. Copy to .env and edit.

# development | test | production. Production refuses DEV_AUTH.
NODE_ENV=development
# Port the API listens on. The web app expects 3001 by default.
PORT=3001
# fatal | error | warn | info | debug | trace | silent. JSON lines either way.
LOG_LEVEL=info

# The application role. It is not the owner of the tables, so row-level security applies to it.
DATABASE_URL=postgres://ecapital_app:change-me@localhost:5432/ecapital
# The owner role, used by `pnpm migrate` and `pnpm seed` only. Defaults to DATABASE_URL.
MIGRATION_DATABASE_URL=postgres://ecapital:change-me@localhost:5432/ecapital
# Maximum connections in the pool. One per concurrent request, so keep it near your worker count.
DATABASE_POOL_MAX=10

# dev | ldap | oidc (ADR-0018). Left empty it follows DEV_AUTH: 1 means dev, anything else oidc.
AUTH_MODE=dev
# 1 turns on the local token stub for development and tests (ADR-0009). Never 1 in production.
DEV_AUTH=1
# The key the stub signs with. At least 16 characters. Irrelevant when DEV_AUTH is off.
DEV_AUTH_SECRET=ecapital-dev-auth-secret-not-for-production
# The key the dev and ldap session tokens are signed with. Falls back to DEV_AUTH_SECRET.
SESSION_SECRET=
# 1 lets the API boot with DEV_AUTH on in production. It refuses otherwise, and warns loudly either way.
ALLOW_DEV_AUTH_IN_PRODUCTION=

# Entra ID tenant issuer, for example https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_ISSUER=
# The application (client) id registered in Entra ID.
OIDC_CLIENT_ID=
# The audience the access token must carry, usually the API's application id URI.
OIDC_AUDIENCE=
# Signing keys. Left empty, it is derived from OIDC_ISSUER.
OIDC_JWKS_URI=

# ADR-0018 — the ΟΚΥπΥ Active Directory, the one eMAP and eFinance already bind against.
# ldap:// or ldaps:// and the port, for example ldap://dc01.ihcis.local:389
LDAP_URL=
# Where the user entries are searched for, for example DC=ihcis,DC=local
LDAP_BASE_DN=
# The AD domain appended to a bare username to make the UPN it binds with, for example ihcis.local
LDAP_DOMAIN=
# 1 upgrades a plain ldap:// connection to TLS before the bind. Needs a certificate on the domain controller.
LDAP_START_TLS=
# The attribute holding the account name. sAMAccountName on Active Directory; leave it alone.
LDAP_UID_ATTRIBUTE=sAMAccountName
# How long to wait for the directory, in milliseconds.
LDAP_TIMEOUT_MS=8000

# ADR-0019 — the sibling systems on the ΟΚΥπΥ server. Empty means the link-outs do not appear.
# eMAP (procurement), for example https://map.shso.online
EMAP_URL=
# eFinance (invoices and budget), for example https://finance.shso.online
EFINANCE_URL=
# ADR-0022 — the bearer token eFinance issues eCapital as its one caller on
# the loopback contract. Only used by POST /budget-codes/sync (ADR-0025);
# left empty, that route falls back to eCapital's own seed list.
EFINANCE_TOKEN=

# ADR-0018 §5 — production hardening. Behind cloudflared the API should listen on the loopback only.
BIND_HOST=
# 1 trusts one hop of X-Forwarded-For / -Proto / -Host. Only ever behind a proxy that sets them.
TRUST_PROXY=

# el or en. The language of error messages when Accept-Language says nothing.
DEFAULT_LOCALE=el
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
