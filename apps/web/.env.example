# eCapital web app. Copy to .env.local and edit. Both variables are
# NEXT_PUBLIC_, so they are inlined into the browser bundle: never put a
# secret here. The API token is not one of these — it lives in an httpOnly
# cookie the browser cannot read (ADR-0013).

# Where the NestJS API listens. Must match apps/api's PORT, and the origin
# must appear in that app's CORS_ORIGINS. Defaults to http://localhost:3001
# when unset (R15: the data source is swapped here, not in a caller).
NEXT_PUBLIC_API_BASE=http://localhost:3001

# 1 shows the eight seeded accounts on the sign-in screen (ADR-0009). It only
# fills the field: the API still has to be running with DEV_AUTH=1, or it
# answers 404 to /auth/dev-token. Never 1 on the ΟΚΥπΥ server.
NEXT_PUBLIC_DEV_AUTH=1

# dev | ldap | oidc — which sign-in form S00 draws (ADR-0018). It must match
# the API's own AUTH_MODE, or people type into a field the API does not read.
# Left unset it follows NEXT_PUBLIC_DEV_AUTH: 1 means dev, otherwise oidc.
NEXT_PUBLIC_AUTH_MODE=dev

# The origin the browser uses to reach this app, for example
# https://capital.shso.online. It decides one thing only: whether the session
# cookie carries `Secure` (ADR-0018 §5). It is the origin and not NODE_ENV
# because behind cloudflared this process speaks plain HTTP while the browser
# is on HTTPS — and `Secure` on a plain-HTTP developer origin means the cookie
# is silently never stored and nobody can sign in at all.
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
